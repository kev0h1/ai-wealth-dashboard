# Install only after H118 is reviewed and merged. No model is called by an
# unchanged poll. This does not merge branches or restart application services.
[Unit]
Description=Dispatch Codex work only for actionable board changes
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/ai-wealth-dashboard/scripts/codex_board_watcher.py

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/ai-wealth-dashboard
UMask=0077
ExecStart=/root/ai-wealth-dashboard/backend/.venv/bin/python /root/ai-wealth-dashboard/scripts/codex_board_watcher.py --once --dispatch --quiet
TimeoutStartSec=2h5min
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/root/ai-wealth-dashboard /root/worktrees /root/.codex /tmp
InaccessiblePaths=-/run/systemd/private -/run/dbus/system_bus_socket -/var/run/docker.sock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
