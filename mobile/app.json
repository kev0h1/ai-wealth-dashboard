{
  "expo": {
    "name": "Wealth Dashboard",
    "slug": "wealth-dashboard",
    "scheme": "wealthdash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.uk.auriqltd.wealth",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of receipts to track your grocery prices.",
        "NSPhotoLibraryUsageDescription": "Choose receipt photos to track your grocery prices.",
        "NSFaceIDUsageDescription": "Unlock your financial dashboard with Face ID.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.uk.auriqltd.wealth",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find cheaper fuel near you."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.IOS_CLIENT_ID_PLACEHOLDER"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#b91c1c"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your financial dashboard with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of receipts to track your grocery prices."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://wealth.auriqltd.co.uk/api",
      "googleWebClientId": "828077252293-bvcdr0nop66lc6uatvrh4m4vhdtb2vbo.apps.googleusercontent.com",
      "googleIosClientId": "",
      "router": {},
      "eas": {
        "projectId": "c316c0dc-32a7-4111-8b67-4299c53c4e69"
      }
    },
    "owner": "kev0h1"
  }
}
