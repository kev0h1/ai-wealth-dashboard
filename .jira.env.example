# Copy this file to .jira.env in the repo root and fill in real values.
# .jira.env is gitignored — never commit it. See docs/ops/JIRA.md for the
# one-time Jira setup this depends on.

# Jira Cloud site base URL, no trailing slash.
JIRA_BASE_URL=https://auriqltd.atlassian.net

# Kevin's Atlassian account email and an API token for it, created at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=kevin@example.com
JIRA_API_TOKEN=

# Kanban software project key. Defaults to SRT if unset.
JIRA_PROJECT_KEY=SRT

# Atlassian accountIds (not emails) for the two people/roles that own
# backlog items. Find them via GET /rest/api/3/myself (once authenticated
# as that user) or the Jira people directory.
JIRA_ASSIGNEE_KEVIN=
JIRA_ASSIGNEE_CLAUDE=

# Which identity performs the transitions this session runs: "kevin" or
# "claude". Defaults to "claude". Only changes attribution when the two
# optional Claude credentials below are also set — otherwise every
# transition uses JIRA_EMAIL/JIRA_API_TOKEN regardless of this value.
JIRA_ACTOR=claude

# Optional: a second Atlassian user ("Claude") and its API token, so
# sessions transition issues as themselves instead of as Kevin.
JIRA_CLAUDE_EMAIL=
JIRA_CLAUDE_API_TOKEN=
